      "isDeleted": false,
      "boundElements": [],
      "updated": 1792346108056,
      "created": 1792345832073,
      "link": null,
      "locked": false,
      "text": "<-- This one in the description will have the video media aviable, it its possible the maximum\nresolution and bitrate (NOT RE-ENCODES PLEASE), for example, for me, by now, the best version I\ncan get is a yt-dlp URL that it will download the youtube one compressed with the formats\n136+251 (old h264 encoded video with the maximum quality [given by youtube] + opus audio\nencoded), buuutttt, if ayone for some reason has an original .flac or .wav version or any\nversion in higher quality (REAL HIHGER, IS NOT VALID DOWNLOAD THE OPUS OR ANY OTHER VERSION AND\nCONVERT TO .wav/.flac), it will be valid to have both versions uploaded, one is the youtube with\nthe video and audio, and the other one is the audio with the maximum quality to preserve",
      "fontSize": 13.469686283729088,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<-- This one in the description will have the video media aviable, it its possible the maximum resolution and bitrate (NOT RE-ENCODES PLEASE), for example, for me, by now, the best version I can get is a yt-dlp URL that it will download the youtube one compressed with the formats 136+251 (old h264 encoded video with the maximum quality [given by youtube] + opus audio encoded), buuutttt, if ayone for some reason has an original .flac or .wav version or any version in higher quality (REAL HIHGER, IS NOT VALID DOWNLOAD THE OPUS OR ANY OTHER VERSION AND CONVERT TO .wav/.flac), it will be valid to have both versions uploaded, one is the youtube with the video and audio, and the other one is the audio with the maximum quality to preserve",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
