{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Internet Lore entry",
  "description": "Schema for data/<year>/<slug>/entry.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "creation", "tags", "urls", "connect"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema, used by editors for autocompletion."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "creation": {
      "type": "string",
      "format": "partial-date",
      "description": "ISO 8601 date using the most precise form available: YYYY, YYYY-MM or YYYY-MM-DD (always try to use YYYY-MM-DD even if its with an aproximated date)."
    },
    "tags": {
      "type": "array",
      "description": "Tags from data/tags.json.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "connect": {
      "type": "array",
      "description": "Ids of related entries, relative to data/ and without the entry.json file name.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}/[^/]+$"
      }
    }
  }
}
